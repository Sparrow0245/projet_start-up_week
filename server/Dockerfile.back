
# ────────────────────────────────────────────────
# Stage 1 – Builder + unit tests
# ────────────────────────────────────────────────
FROM maven:3.9-eclipse-temurin-21 AS builder

WORKDIR /build

# Copy only pom.xml first → better layer caching
COPY pom.xml .
# Download dependencies (cached layer if pom didn't change)
RUN mvn dependency:go-offline -B

# Now copy source code
COPY src ./src

# Environment variables needed at build time (if any profiles / plugins need them)
ENV BREVO_API_KEY=${BREVO_API_KEY}
ENV GEMINI_API_KEY=${GEMINI_API_KEY}

# ── Run unit + integration tests that DON'T need docker-in-docker ──
# If you have Testcontainers → see alternatives below
RUN mvn clean verify -e \
    -Dmaven.test.failure.ignore=false \
    -DskipITs=true                # ← skip integration tests (fast build)

# If you want to run **everything** that doesn't need docker (unit + some lightweight IT)
# RUN mvn clean verify ...

# Only if tests pass → package the artifact
RUN mvn package -DskipTests

# ────────────────────────────────────────────────
# Stage 2 – Production image (very small)
# ────────────────────────────────────────────────
FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

# Copy only the final jar from builder stage
COPY --from=builder /build/target/*.jar app.jar

# These are needed at runtime
ENV BREVO_API_KEY=${BREVO_API_KEY}
ENV GEMINI_API_KEY=${GEMINI_API_KEY}

EXPOSE 8080

# Best practice: run as non-root
RUN addgroup --system spring && adduser --system --ingroup spring spring
USER spring:spring

ENTRYPOINT ["java", "-jar", "/app/app.jar"]